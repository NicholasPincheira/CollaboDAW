    "deploy": "wrangler pages deploy dist --project-name=collabodaw-pages --commit-dirty=true",
    "deploy:worker": "wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.3.3",
    "gsap": "^3.15.0",
